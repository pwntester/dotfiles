{
  "global": {
    "ask_for_confirmation_before_quitting": true,
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": false,
    "show_profile_name_in_menu_bar": false,
    "unsafe_ui": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": {
        "country_code": 0,
        "keyboard_type_v2": "ansi"
      },
      "complex_modifications": {
        "parameters": {
          "basic.simultaneous_threshold_milliseconds": 50,
          "basic.to_delayed_action_delay_milliseconds": 500,
          "basic.to_if_alone_timeout_milliseconds": 200,
          "basic.to_if_held_down_threshold_milliseconds": 200,
          "mouse_motion_to_scroll.speed": 100
        },
        "rules": [
          {
            "description": "Change Caps Lock to Control when used as modifier, Backspace when used alone",
            "manipulators": [
              {
              "from": {
                "key_code": "caps_lock",
                "modifiers": { 
                  "optional": ["any"] 
                }
              },
              "to": [
                {
                  "key_code": "left_control",
                  "lazy": true
                }
              ],
              "to_if_alone": [
                { 
                  "key_code": "delete_or_backspace" 
                }
              ],
              "to_if_held_down": [
                { 
                  "key_code": "delete_or_backspace" 
                }
              ],
              "type": "basic"
              }
            ]
          },
          {
            "description": "Change command + h/j/k/l to Arrows",
            "manipulators": [
              {
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "product_id": 835,
                        "vendor_id": 1452
                      }
                    ]
                  }
                ],
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": ["command"],
                    "optional": ["caps_lock"]
                  }
                },
                "to": [
                  { "key_code": "left_arrow" }
                ],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "product_id": 835,
                        "vendor_id": 1452
                      }
                    ]
                  }
                ],
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "mandatory": ["command"],
                    "optional": ["caps_lock"]
                  }
                },
                "to": [
                  { "key_code": "down_arrow" }
                ],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "product_id": 835,
                        "vendor_id": 1452
                      }
                    ]
                  }
                ],
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["command"],
                    "optional": ["caps_lock"]
                  }
                },
                "to": [
                    { "key_code": "up_arrow" }
                ],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "product_id": 835,
                        "vendor_id": 1452
                      }
                    ]
                  }
                ],
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["command"],
                    "optional": ["caps_lock"]
                  }
                },
                "to": [
                  { "key_code": "up_arrow" }
                ],
                "type": "basic"
              }
            ]
          }
        ]
      },
      "devices": [
        {
          "identifiers": {
            "is_keyboard": true,
            "product_id": 6505,
            "vendor_id": 12951
          },
          "manipulate_caps_lock_led": false
        }
      ]
    }
  ]
}
