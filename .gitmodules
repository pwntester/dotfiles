[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "home/zsh/prompts/git-prompt.zsh"]
	path = home/zsh/prompts/git-prompt.zsh
  url = https://github.com/woefe/git-prompt.zsh.git
[submodule "zsh/plugins/fast-syntax-highlighting"]
	path = zsh/plugins/fast-syntax-highlighting
	url = https://github.com/zdharma/fast-syntax-highlighting
[submodule "home/zsh/plugins/zsh-completions"]
	path = home/zsh/plugins/zsh-completions
	url = https://github.com/zsh-users/zsh-completions.git
[submodule "home/zsh/plugins/zsh-history-substring-search"]
	path = home/zsh/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search.git
[submodule "home/zsh/plugins/zsh-syntax-highlighting"]
	path = home/zsh/plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting.git
[submodule "tmux/.config/tmux/plugins/catppuccin-tmux"]
	path = tmux/.config/tmux/plugins/catppuccin-tmux
	url = https://github.com/dreamsofcode-io/catppuccin-tmux.git
[submodule "dev-templates"]
	path = dev-templates
	url = https://github.com/the-nix-way/dev-templates.git
