
# theme
theme = catppuccin-macchiato

# font
#font-family = "MonaspiceNe Nerd Font"
font-family = Source Code Pro Light
font-style-bold = Source Code Pro Medium
font-style-italic = Source Code Pro ExtraLight Italic
font-style-bold-italic = Source Code Pro Italic

font-size = 15
font-thicken = true
# Disable ligatures as described here:
# https://ghostty.org/docs/config/reference#font-feature
font-feature = -calt
font-feature = -liga
font-feature = -dlig
# Enable slashed zero.
font-feature = zero

adjust-cell-height = 10%
window-decoration=false
mouse-hide-while-typing = true
macos-non-native-fullscreen=visible-menu
macos-option-as-alt = true
macos-titlebar-style = hidden
copy-on-select = true
# macos-titlebar-style = tabs

# TMUX integration considering that my leader key is ctrl + b
# new tab
keybind = cmd+t=text:\x02c
# tmux sesh
keybind = cmd+k=text:\x02T
# tmux floax
keybind = cmd+f=text:\x02p
# lazygit/gitui
keybind = cmd+g=text:\x02g
# Rename a tmux window on Cmd+r in tmux it is Ctrl+b+,
keybind = cmd+r=text:\x02\x2c
# Split the window horizontally on Cmd+minus in tmux it is Ctrl+b+"
keybind = super+minus=text:\x02\x22
# Split the window vertically on Cmd+backslash in tmux it is Ctrl+b+%
# TODO: I want to change it Cmd+pipe but looks like ghostty doesn't support that key for now
keybind = super+backslash=text:\x02\x25
# tab
keybind = cmd+one=text:\x021
keybind = cmd+two=text:\x022
keybind = cmd+three=text:\x023
keybind = cmd+four=text:\x024
keybind = cmd+five=text:\x025
keybind = cmd+six=text:\x026
keybind = cmd+seven=text:\x027
keybind = cmd+eight=text:\x028
keybind = cmd+nine=text:\x029
